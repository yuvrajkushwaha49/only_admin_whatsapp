# Application
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
SINGLE_COMPANY_MODE=true
DEFAULT_BUSINESS_ID=1

# Database (MySQL 8)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=campaignflow
DATABASE_USER=cf_user
DATABASE_PASSWORD=cf_password
DATABASE_CONNECTION_LIMIT=10

# Redis (BullMQ queues)
REDIS_URL=redis://localhost:6379

# JWT & Authentication
JWT_SECRET=dev_jwt_secret_campaignflow_super_secure_key_12345
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=dev_refresh_secret_campaignflow_key_98765
REFRESH_TOKEN_EXPIRES_IN=7d

# Meta WhatsApp Business Cloud API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=campaignflow_meta_verify_token_xyz
WHATSAPP_API_VERSION=v21.0
# Optional Direct System User Connect (.env Option B)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=

# Optional Storage (AWS S3)
S3_BUCKET=campaignflow-uploads-dev
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=placeholder_key
AWS_SECRET_ACCESS_KEY=placeholder_secret

# AI Promotional Copy Generator & Support Chatbot
AI_PROVIDER=mock # options: mock, openai, gemini
OPENAI_API_KEY=placeholder_openai_key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.3
AI_MAX_OUTPUT_TOKENS=1000
AI_REQUEST_TIMEOUT=30000
AI_CHAT_ENABLED=true

# WhatsApp sending throttle
MAX_MESSAGES_PER_SECOND=20
RECIPIENT_BATCH_SIZE=50

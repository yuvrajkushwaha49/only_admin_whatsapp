# Application
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://whatsappdrt.cloud
SINGLE_COMPANY_MODE=true
DEFAULT_BUSINESS_ID=1

# Real MySQL 8 (Installed natively on this EC2 instance)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=campaignflow
DATABASE_USER=cf_user
DATABASE_PASSWORD=CampaignFlow2026!Secure
DATABASE_CONNECTION_LIMIT=20

# Optional Redis for background worker queues (or localhost if installed)
REDIS_URL=redis://localhost:6379

# JWT & Authentication
JWT_SECRET=super_secure_production_jwt_secret_campaignflow_2026_xyz
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=super_secure_production_refresh_secret_998877
REFRESH_TOKEN_EXPIRES_IN=7d

# Meta WhatsApp Cloud API & Embedded Signup (Platform level config - Accounts stored in DB)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret_here
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_TOKEN_ENCRYPTION_KEY=super_secure_32_bytes_token_encryption_key_2026
META_WEBHOOK_VERIFY_TOKEN=campaignflow_secure_webhook_token_2026
WHATSAPP_API_VERSION=v21.0
# Optional Direct System User Connect (.env Option B)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=

# Throttle limits
MAX_MESSAGES_PER_SECOND=20
RECIPIENT_BATCH_SIZE=50
